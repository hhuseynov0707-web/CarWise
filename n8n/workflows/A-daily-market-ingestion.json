{
  "name": "A - Daily market ingestion",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 3 * * *"
            }
          ]
        }
      },
      "name": "Every day 03:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        200,
        300
      ]
    },
    {
      "parameters": {
        "url": "={{$env.AUTOINTEL_API_URL}}/health",
        "options": {
          "timeout": 15000
        }
      },
      "name": "Read health",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        420,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true
          },
          "conditions": [
            {
              "leftValue": "={{ $json.ingestion }}",
              "rightValue": "enabled",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ]
        }
      },
      "name": "Ingestion enabled?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        660,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$env.AUTOINTEL_API_URL}}/admin/ingestion/run",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ source: \"turbo.az\", max_listings: 500 }) }}",
        "options": {
          "timeout": 3600000
        }
      },
      "name": "Run ingestion",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        920,
        200
      ],
      "notes": "The backend refuses this call while the adapter's extraction rules are unverified. That refusal is deliberate: an untested parser writes nulls rather than errors.",
      "notesInFlow": true
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true
          },
          "conditions": [
            {
              "leftValue": "={{ $json.degraded_fields.length }}",
              "rightValue": 0,
              "operator": {
                "type": "number",
                "operation": "equals"
              }
            }
          ]
        }
      },
      "name": "Extraction healthy?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        1160,
        200
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$env.AUTOINTEL_API_URL}}/admin/snapshots/build",
        "options": {
          "timeout": 1800000
        }
      },
      "name": "Build snapshots",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1400,
        120
      ]
    },
    {
      "parameters": {},
      "name": "Alert - parser degraded",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        1400,
        300
      ],
      "notes": "Wire this to your alerting channel. A drop in per-field extraction rates is how a markup change announces itself. HTTP status codes will look perfectly healthy while it happens (audit section 3).",
      "notesInFlow": true
    },
    {
      "parameters": {},
      "name": "Skipped - ingestion disabled",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        920,
        420
      ],
      "notes": "Ships disabled. Enable only after somebody has read the source's terms of service and recorded that decision (audit section 4).",
      "notesInFlow": true
    }
  ],
  "connections": {
    "Every day 03:00": {
      "main": [
        [
          {
            "node": "Read health",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Read health": {
      "main": [
        [
          {
            "node": "Ingestion enabled?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Ingestion enabled?": {
      "main": [
        [
          {
            "node": "Run ingestion",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Skipped - ingestion disabled",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Run ingestion": {
      "main": [
        [
          {
            "node": "Extraction healthy?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Extraction healthy?": {
      "main": [
        [
          {
            "node": "Build snapshots",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Alert - parser degraded",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "timezone": "Asia/Baku"
  }
}
