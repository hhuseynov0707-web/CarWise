# Production environment.
#
# Copy to .env on the deployment host and fill in. Never commit the filled-in
# file; .gitignore already excludes .env.
#
# Used together with the production overlay:
#   docker compose -f docker-compose.yml -f docker-compose.prod.yml up -d --build

ENVIRONMENT=production
DEBUG=false
DEFAULT_LANGUAGE=az

# --- Database --------------------------------------------------------------
# The host is the compose service name, not localhost: these talk to each other
# over the compose network, and the production overlay stops publishing the
# database port to the outside world.
POSTGRES_USER=autointel
POSTGRES_PASSWORD=
POSTGRES_DB=autointel
DATABASE_URL=postgresql+psycopg://autointel:CHANGE_ME@postgres:5432/autointel
DATABASE_ECHO=false

REDIS_URL=redis://redis:6379/0

# --- Security --------------------------------------------------------------
# Required, 32+ characters. The application refuses to start without it outside
# local. Generate with:  openssl rand -hex 32
SECRET_KEY=

# Admin endpoints fail closed: with this unset they return 503 rather than
# running unauthenticated. Set it only if something needs to call them.
ADMIN_API_KEY=

# The site's own origin, and only that. A wildcard here would let any page on
# the internet make authenticated requests with the visitor's session cookie.
#
# With the bundled Caddy the browser never makes a cross-origin request at all
# — the API is served under the same host — so this is a backstop rather than
# the thing holding the site together. It still has to be right.
CORS_ORIGINS=["https://your-domain.example"]
RATE_LIMIT_PER_MINUTE=60

# --- Reasoning layer -------------------------------------------------------
# Optional. Without a key every report is still complete and is labelled as
# computed rather than AI-written; the expert conversation reports itself as
# unavailable, because a conversation has nothing to fall back to.
REASONING_ENABLED=true
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_BASE_URL=https://api.openai.com/v1
REASONING_MAX_ATTEMPTS=2

# --- Ingestion -------------------------------------------------------------
# Off by default on a deployment. Crawling from a public service is a different
# act from crawling from a laptop, and it should be a decision rather than
# something inherited from a config file.
INGESTION_ENABLED=false
CRAWL_REQUESTS_PER_SECOND=0.5
CRAWL_BURST=3
CRAWL_USER_AGENT=AutoIntelBot/0.1 (+https://your-domain.example/bot)
CRAWL_MAX_PAGES_PER_RUN=500

# --- Analysis --------------------------------------------------------------
COMPARABLE_TARGET_SAMPLE=25
COMPARABLE_MIN_SAMPLE=5
OBSERVATION_WINDOW_DAYS=180

# --- Public address --------------------------------------------------------
# The hostname Caddy serves and obtains a certificate for. One of:
#
#   example.az           a real domain, with an A record pointing at this host
#   1.2.3.4.sslip.io     no domain yet — sslip.io resolves the address in the
#                        name, which gives Let's Encrypt something it will
#                        actually issue for. It refuses bare IPs.
#   :80                  plain HTTP, smoke tests only. Sign-in will not work,
#                        because the session cookie is Secure outside local.
SITE_ADDRESS=

# --- Frontend --------------------------------------------------------------
# Left relative on purpose. Caddy serves the API under the site's own origin,
# so the browser resolves this against whatever host served the page — which
# is what lets the same image move from an sslip.io address to a real domain
# without a rebuild. Next inlines NEXT_PUBLIC_* at build time, so an absolute
# URL here would tie the built image to one hostname.
# Set it absolute only if the API lives on a different host.
NEXT_PUBLIC_API_URL=/api/v1

# How many uvicorn workers the API runs. Two is a sensible floor.
API_WORKERS=2
