# ---------------------------------------------------------------------------
# AutoIntel Azerbaijan — environment template
# Copy to .env and fill in. Never commit the filled-in file.
# ---------------------------------------------------------------------------

ENVIRONMENT=local
DEBUG=true
DEFAULT_LANGUAGE=az

# --- Database ---
DATABASE_URL=postgresql+psycopg://autointel:autointel@localhost:5432/autointel
DATABASE_ECHO=false

# --- Cache ---
REDIS_URL=redis://localhost:6379/0

# --- Reasoning layer (Grok) -------------------------------------------------
# The platform works fully without this. Every number, comparable, risk signal
# and inspection priority is computed by the analytical engines; the model only
# writes the narrative prose. With no key set, reports are generated from the
# computed evidence directly and are labelled as such.
REASONING_ENABLED=true
GROK_API_KEY=
# Set this to a model your account actually has access to.
GROK_MODEL=grok-4
GROK_BASE_URL=https://api.x.ai/v1
REASONING_MAX_ATTEMPTS=2

# --- Ingestion --------------------------------------------------------------
# SHIPS DISABLED ON PURPOSE.
#
# Before setting this to true:
#   1. Read the source site's terms of service. A person must make this call.
#   2. Record that decision somewhere durable.
#   3. Verify the extraction rules:
#        python -m app.adapters.market.verify_turbo <listing-url>
#      then set "verified": true on each rule in selectors.json.
#
# The service refuses to ingest while any rule is unverified, so an untested
# parser cannot fill the market database with nulls.
INGESTION_ENABLED=false

# One request per five seconds, sustained. Hard-capped at 2/s in code.
CRAWL_REQUESTS_PER_SECOND=0.2
CRAWL_BURST=3
CRAWL_USER_AGENT=AutoIntelBot/0.1 (+https://autointel.az/bot)
CRAWL_MAX_PAGES_PER_RUN=500

# --- Analysis policy --------------------------------------------------------
COMPARABLE_TARGET_SAMPLE=25
COMPARABLE_MIN_SAMPLE=5
OBSERVATION_WINDOW_DAYS=180

# --- Security ---------------------------------------------------------------
# Required (32+ chars) in staging and production; the app refuses to start
# without it there. Generate with: openssl rand -hex 32
SECRET_KEY=
CORS_ORIGINS=["http://localhost:3000"]
RATE_LIMIT_PER_MINUTE=60

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
